{
  "name": "read2me",
  "displayName": "READ2ME",
  "description": "Read the active file aloud with offline Piper neural TTS — highlights the current sentence and word, with play/pause/stop, a speed stepper, and selectable voices.",
  "version": "0.0.6",
  "publisher": "ofirski",
  "author": {
    "name": "Ofir Kerker",
    "url": "https://github.com/ofirski"
  },
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://read2me.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofirski/READ2ME.git",
    "directory": "tts-extension"
  },
  "bugs": {
    "url": "https://github.com/ofirski/READ2ME/issues"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "read aloud",
    "piper",
    "markdown",
    "accessibility",
    "offline",
    "neural voice"
  ],
  "galleryBanner": {
    "color": "#0a0b12",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "read2me.play",
        "title": "READ2ME: Read aloud / resume"
      },
      {
        "command": "read2me.pause",
        "title": "READ2ME: Pause reading"
      },
      {
        "command": "read2me.stop",
        "title": "READ2ME: Stop reading"
      },
      {
        "command": "read2me.speedUp",
        "title": "READ2ME: Read faster"
      },
      {
        "command": "read2me.speedDown",
        "title": "READ2ME: Read slower"
      },
      {
        "command": "read2me.speedReset",
        "title": "READ2ME: Reset reading speed to 1x"
      },
      {
        "command": "read2me.selectVoice",
        "title": "READ2ME: Select voice"
      }
    ],
    "keybindings": [
      {
        "command": "read2me.play",
        "key": "ctrl+cmd+r"
      },
      {
        "command": "read2me.pause",
        "key": "ctrl+cmd+p"
      },
      {
        "command": "read2me.stop",
        "key": "ctrl+cmd+s"
      }
    ],
    "configuration": {
      "title": "READ2ME",
      "properties": {
        "read2me.pythonPath": {
          "type": "string",
          "default": ".tts-venv/bin/python",
          "description": "Path to the Python interpreter (relative to the workspace folder, or absolute)."
        },
        "read2me.serverScript": {
          "type": "string",
          "default": "tts_server.py",
          "description": "Path to tts_server.py (relative to the workspace folder, or absolute)."
        },
        "read2me.voicesDir": {
          "type": "string",
          "default": "tts-voices",
          "description": "Folder scanned for .onnx voices (relative to the workspace folder, or absolute)."
        },
        "read2me.model": {
          "type": "string",
          "default": "tts-voices/en_US-lessac-high.onnx",
          "description": "Default Piper .onnx voice model (used until a voice is picked via 'READ2ME: Select voice')."
        },
        "read2me.config": {
          "type": "string",
          "default": "tts-voices/en_US-lessac-high.onnx.json",
          "description": "Default Piper .onnx.json config matching the default model."
        },
        "read2me.rate": {
          "type": "number",
          "default": 1.0,
          "description": "Base speech rate. 1.0 = natural; >1.0 = faster. The speed stepper multiplies this."
        },
        "read2me.wordHighlightColor": {
          "type": "string",
          "default": "rgba(255,56,92,0.35)",
          "description": "Background color of the word currently being spoken."
        },
        "read2me.sentenceHighlightColor": {
          "type": "string",
          "default": "rgba(255,56,92,0.12)",
          "description": "Background color of the sentence currently being spoken."
        }
      }
    }
  }
}
